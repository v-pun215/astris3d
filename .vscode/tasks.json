{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "G++ Build Current File",
      "command": "bash",
      "args": [
        "-lc",
        "mkdir -p \"${fileDirname}/output\" && /opt/homebrew/bin/g++-15 -std=c++17 -g \"${file}\" -o \"${fileDirname}/output/${fileBasenameNoExtension}\" && cd \"${fileDirname}/output\" && ./\"${fileBasenameNoExtension}\""
      ],
      "linux": {
        "args": [
          "-lc",
          "mkdir -p \"${fileDirname}/output\" && /usr/bin/g++ -std=c++17 -g \"${file}\" -o \"${fileDirname}/output/${fileBasenameNoExtension}\" && cd \"${fileDirname}/output\" && ./\"${fileBasenameNoExtension}\""
        ]
      },
      "windows": {
        "command": "cmd",
        "args": [
          "/c",
          "if not exist \"${fileDirname}\\output\" mkdir \"${fileDirname}\\output\" && g++ -std=c++17 -g \"${file}\" -o \"${fileDirname}\\output\\${fileBasenameNoExtension}.exe\" && cd /d \"${fileDirname}\\output\" && \"${fileBasenameNoExtension}.exe\""
        ]
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "type": "shell",
      "label": "G++ Build All Files",
      "command": "bash",
      "args": [
        "-lc",
        "mkdir -p \"${fileDirname}/output\" && /opt/homebrew/bin/g++-15 -std=c++17 -g \"${fileDirname}\"/*.cpp -o \"${fileDirname}/output/app\" && cd \"${fileDirname}/output\" && ./app"
      ],
      "linux": {
        "args": [
          "-lc",
          "mkdir -p \"${fileDirname}/output\" && /usr/bin/g++ -std=c++17 -g \"${fileDirname}\"/*.cpp -o \"${fileDirname}/output/app\" && cd \"${fileDirname}/output\" && ./app"
        ]
      },
      "windows": {
        "command": "cmd",
        "args": [
          "/c",
          "if not exist \"${fileDirname}\\output\" mkdir \"${fileDirname}\\output\" && g++ -std=c++17 -g \"${fileDirname}\\*.cpp\" -o \"${fileDirname}\\output\\app.exe\" && cd /d \"${fileDirname}\\output\" && app.exe"
        ]
      },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}