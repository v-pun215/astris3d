{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "process",
      "label": "G++ Build Current File",
      "command": "g++",
      "args": [
        "-std=c++17",
        "-g",
        "${file}",
        "-o",
        "${fileDirname}/output/${fileBasenameNoExtension}"
      ],
      "osx": {
        "command": "/opt/homebrew/bin/g++-15",
        "args": [
          "-std=c++17",
          "-g",
          "${file}",
          "-o",
          "${fileDirname}/output/${fileBasenameNoExtension}"
        ]
      },
      "linux": {
        "command": "g++",
        "args": [
          "-std=c++17",
          "-g",
          "${file}",
          "-o",
          "${fileDirname}/output/${fileBasenameNoExtension}"
        ]
      },
      "windows": {
        "command": "g++",
        "args": [
          "-std=c++17",
          "-g",
          "${file}",
          "-o",
          "${fileDirname}/output/${fileBasenameNoExtension}.exe"
        ]
      },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "type": "process",
      "label": "Run Current File",
      "command": "${fileDirname}/output/${fileBasenameNoExtension}",
      "windows": {
        "command": "${fileDirname}/output/${fileBasenameNoExtension}.exe"
      },
      "dependsOn": "G++ Build Current File",
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "G++ Build All Files",
      "command": "bash",
      "args": [
        "-lc",
        "mkdir -p \"${fileDirname}/output\" && /opt/homebrew/bin/g++-15 -std=c++17 -g \"${fileDirname}\"/*.cpp -o \"${fileDirname}/output/app\" && cd \"${fileDirname}/output\" && ./app"
      ],
      "linux": {
        "args": [
          "-lc",
          "mkdir -p \"${fileDirname}/output\" && /usr/bin/g++ -std=c++17 -g \"${fileDirname}\"/*.cpp -o \"${fileDirname}/output/app\" && cd \"${fileDirname}/output\" && ./app"
        ]
      },
      "windows": {
        "command": "cmd",
        "args": [
          "/c",
          "if not exist \"${fileDirname}\\output\" mkdir \"${fileDirname}\\output\" & g++ -std=c++17 -g \"${fileDirname}\\*.cpp\" -o \"${fileDirname}\\output\\app.exe\" && cd /d \"${fileDirname}\\output\" && app.exe"
        ]
      },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}
